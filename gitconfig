[init]
  defaultBranch = main

[user]
  name  = Tsukasa Nishiyama
  email = nsymtks@gmail.com
  signingkey = 9F0B982A8D3E2677DF5F597279583869D82BE1E1

[core]
  excludesfile = ~/.gitignore_global
  quotepath    = false
  editor       = nvim

[push]
  default = simple

[alias]
  ad  = "!git status --short | fzf | awk '{print $2}' | xargs git add"
  br  = branch
  bra = branch
  ba  = branch -a
  bd  = branch -d
  bm  = branch --merged
  bn  = branch --no-merged
  co  = checkout
  cm  = commit
  di  = diff
  df  = "!git lg | fzf | awk '{print $2}' | xargs -I% git diff %^ %"
  fe  = fetch --all --prune
  lf  = log --graph --decorate --pretty=fuller
  ls  = log --graph --decorate --pretty=format:\"%ad [%Cgreen%cn%Creset] %h> %n %Cred%d%Creset %s %n\" --name-status
  ld  = log --graph --decorate --pretty=format:\"%ad [%Cgreen%cn%Creset] <c:%h t:%t p:%p> %n %Cred%d%Creset %s %n\" --stat -p
  lg  = log --graph --pretty=format:'%Cgreen%h %Creset%cd %C(bold blue)[%cn] %Creset%s%C(yellow)%d%C(reset)' --date=relative --decorate --all
  re  = rebase
  ri  = rebase -i
  st  = status
  sw  = switch
  re  = restore
  up  = pull --rebase
  # short
  b   = branch
  d   = diff
  l   = ld
  p   = pull --rebase
  r   = restore
  s   = status

[color]
  ui     = auto
  diff   = auto
  status = auto
  branch = auto

[diff]
  tool = nvimdiff
  compactionHeuristic = true

[github]
  user = tukaelu

[ghq]
  user = tukaelu
  root = ~/ghq

[web]
  browser = open

[gpg]
	program = /usr/bin/gpg

[commit]
	gpgsign = true

[tag]
	gpgsign = true
