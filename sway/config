# -------- #
# Modifier #
# -------- #
set $mod Mod1

# -------------------- #
# Input/Output Devices #
# -------------------- #

# Monitor
output eDP-1 {
  res 2560x1440
  pos 0 0
  scale 1
}

# Keyboard
input * {
  xkb_layout "us"
  xkb_options "ctrl:nocaps"
}

# Touchpad & Trackpoint
input type:touchpad {
  tap            enabled
  natural_scroll enabled
  accel_profile  adaptive
  pointer_accel  0
  scroll_factor  0.3
  click_method   none
}
input type:pointer {
  accel_profile  flat
  pointer_accel  0.3
  scroll_factor  0.5
}


set $laptop "eDP-1"
bindswitch --reload --locked lid:on  output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

# ----- #
# Theme #
# ----- #

# Gaps
gaps outer 3
gaps inner 15
default_border pixel 3

# Colors
set $bg             #64b4f277
set $bg-inactive    #120e1200
set $bg-urgent      #d9236588
set $text-light     #f2d8e988
set $text-dark      #0b0b0b88
set $text-inactive  #59485088

# matrix
# class                 border        bground       text        indicator     child_border
client.focused          $bg           $bg           $text-dark  $bg           $bg
client.focused_inactive $bg-inactive  $bg-inactive  $text-light $bg-inactive  $bg-inactive
client.unfocused        $bg-inactive  $bg-inactive  $text-light $bg-inactive  $bg-inactive
client.urgent           $bg-urgent    $bg-urgent    $text-light $bg-urgent    $bg-urgent
client.placeholder      $bg-inactive  $bg-inactive  $text-light $bg-inactive  $bg-inactive

# ------------ #
# Environments #
# ------------ #

exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# ---------- #
# Auto start #
# ---------- #

bar {
  swaybar_command waybar
}

exec_always --no-startup-id mako &
exec_always --no-startup-id fcitx5 &
exec_always --no-startup-id nm-applet --indicator &

# wallpaper
exec_always --no-startup-id swaybg -i ~/Pictures/Wallpapers/sebastian-unrau-sp-p7uuT0tw-unsplash.jpg -m fill &

# screenlocker
exec swayidle -w \
  timeout 600  'env LANG=en.US_UTF-8 swaylock -f' \
  timeout 1200 'swaymsg "output * dpms off"' \
  resume       'swaymsg "output * dpms on"' \
  before-sleep 'env LANG=en.US_UTF-8 swaylock -f' \

# -------- #
# Keybinds #
# -------- #

# aliases
set $left   h
set $down   j
set $up     k
set $right  l

# reload configuration
bindsym $mod+r reload

# launch
bindsym $mod+Space  exec wofi
bindsym $mod+Return exec alacritty
bindsym $mod+e      exec alacritty --class ranger -T ranger -e ranger
bindsym $mod+x      exec dolphin
bindsym $mod+b      exec com.google.Chrome

# login session
bindsym $mod+Ctrl+e exec LANG=en.US_UTF-8 wlogout
bindsym $mod+Ctrl+q exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Ctrl+l exec LANG=en.US_UTF-8 swaylock

# screenshot
bindsym $mod+Shift+s exec grimshot --notify save output ~/Pictures/screenshot/$(date "+%Y%m%d-%H%M%S")_grim_full.png
bindsym $mod+Shift+a exec grimshot --notify save area   ~/Pictures/screenshot/$(date "+%Y%m%d-%H%M%S")_grim_area.png
bindsym $mod+Shift+w exec grimshot --notify save window ~/Pictures/screenshot/$(date "+%Y%m%d-%H%M%S")_grim_window.png

# floating
bindsym $mod+t floating toggle

# fullscreen
bindsym $mod+f fullscreen

# kill forcused window
bindsym $mod+q kill

# layout styles
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+d layout toggle split

# split
bindsym $mod+semicolon  splitv
bindsym $mod+apostrophe splith

# window forcus
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+tab    focus mode_toggle

# window move
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# scratchpad
bindsym $mod+minus move scratchpad
bindsym $mod+equal scratchpad show

# container focus
bindsym $mod+p focus parent
bindsym $mod+c focus child

# workspace
bindsym $mod+period workspace next
bindsym $mod+comma  workspace prev
bindsym $mod+1      workspace number "1"
bindsym $mod+2      workspace number "2"
bindsym $mod+3      workspace number "3"
bindsym $mod+4      workspace number "4"
bindsym $mod+5      workspace number "5"
bindsym $mod+6      workspace number "6"
bindsym $mod+7      workspace number "7"
bindsym $mod+8      workspace number "8"
bindsym $mod+9      workspace number "9"
bindsym $mod+0      workspace number "10"

# audio
bindsym XF86AudioRaiseVolume  exec pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym XF86AudioLowerVolume  exec pactl set-sink-volume @DEFAULT_SINK@ -2%
bindsym XF86AudioMute         exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute      exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec brightnessctl set 2%+
bindsym XF86MonBrightnessDown exec brightnessctl set 2%-
bindsym XF86AudioPlay         exec playerctl play-pause
bindsym XF86AudioNext         exec playerctl next
bindsym XF86AudioPrev         exec playerctl previous

# mouse
floating_modifier $mod normal

# -------------------- #
# Window configuration #
# -------------------- #

# always floating window
for_window [app_id="bubble"]            floating enable
for_window [app_id="confirm"]           floating enable
for_window [app_id="dialog"]            floating enable
for_window [app_id="download"]          floating enable
for_window [app_id="error"]             floating enable
for_window [app_id="fcitx5-config"]     floating enable
for_window [app_id="file_progress"]     floating enable
for_window [app_id="imv"]               floating enable
for_window [app_id="kdesystemsettings"] floating enable
for_window [app_id="menu"]              floating enable
for_window [app_id="notification"]      floating enable
for_window [app_id="pop-up"]            floating enable
for_window [app_id="task_dialog"]       floating enable

for_window [instance="ranger"] floating enable
for_window [instance="ranger"] resize set width  1280
for_window [instance="ranger"] resize set height  640

for_window [instance="google-chrome" title="DevTools.*"] floating enable
for_window [instance="google-chrome" title="DevTools.*"] resize set width  1280
for_window [instance="google-chrome" title="DevTools.*"] resize set height 640

for_window [instance="discord"] floating enable

for_window [instance="vlc"] floating enable
for_window [instance="vlc"] resize set width  1280
for_window [instance="vlc"] resize set height  720

for_window [app_id="dolphin"] floating enable
for_window [app_id="dolphin"] resize set width  960
for_window [app_id="dolphin"] resize set height 640
