{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 50,
  "modules-left": [
    "custom/left-spacer",
    "wlr/workspaces",
    "idle_inhibitor",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "custom/weather"
  ],
  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "temperature",
    "memory",
    "backlight",
    "pulseaudio",
    "pulseaudio#microphone",
    "battery",
    "custom/right-spacer"
  ],

  "wlr/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "format": "{icon}",
    "sort-by-number": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": false
  },
  "hyprland/window": {
    "format": "{}",
    "min-length": 30,
    "max-length": 30,
    "rewrite": {
      "(.*) - Google Chrome":"A $1",
      "(.*) - NVIM": "B $1"
    }
  },
  
  "custom/weather" : {
    //shows the current weather and forecast
    "tooltip" : true,
    "format" : "{}",
    "interval" : 30,
    "exec" : "~/.config/waybar/scripts/waybar-wttr.py",
    "return-type" : "json"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  },

  "clock": {
    // "format": "{: %H:%M}",
    "format": "{: %Y.%m.%d(%a) %H:%M}",
    "tooltip-format": "<big>{calendar}</big>"
  },

  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{essid} - {ifname}:{ipaddr}/{cidr} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}:{essid}"
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {num_connections}",
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected": " {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}"
  },

  "memory": {
    "format": "{}% ",
    "interval": 5
  },

  "temperature": {
    "thermal-zone": 1,
    "format": " {temperatureC}°C",
    "critical-threshold": 80,
    "format-critical": " {temperatureC}°C"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["", "", ""],
    "on-scroll-up": "brightnessctl set 1%-",
    "on-scroll-down": "brightnessctl set 1%+",
    "min-length": 6
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": " Muted",
    "on-click": "pamixer -t",
    "on-scroll-up": "pamixer -d 5",
    "on-scroll-down": "pamixer -i 5",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    }
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source -d 5",
    "on-scroll-down": "pamixer --default-source -i 5",
    "scroll-step": 5
  },
  
  "battery": {
    "states": {
      "good": 75,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", "", "", ""]
  },

  "sway/language" : {
    "format": "{}"
  },

  "custom/left-spacer": {
    "format": "{} "
  },
  "custom/right-spacer": {
    "format": "{} "
  }
}
